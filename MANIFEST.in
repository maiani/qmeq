# Root documentation and metadata, listed explicitly. A blanket *.md would
# also ship the agent guidance and the temporary root development plans, which
# are repository-workflow documents, not part of a distribution. REFERENCES.md
# is shipped because source docstrings cite its keys.
include README.md
include INSTALL.md
include LICENSE.md
include AUTHORS.md
include CHANGELOG.md
include REFERENCES.md

# Documentation source and configuration. Build output is not source.
recursive-include docs *
prune docs/site
recursive-exclude docs __pycache__ *.pyc

# docs/docs/notebooks is a symlink to examples/. The notebooks are shipped
# once, through examples/ below; following the symlink would duplicate them.
prune docs/docs/notebooks

# Vendored tutorials, scripts, and appendix notebooks. Shipped in the sdist so
# a source distribution is self-contained, and excluded from the wheel because
# packages.find only collects qmeq*, so examples/ is not an installed package.
recursive-include examples *
recursive-exclude examples *.png *.dat *.pyc
prune examples/.ipynb_checkpoints

# Cython sources and test reference bundles are declared as package-data in
# pyproject.toml; setuptools carries them into the sdist from there.

# Generated C. setup.py cythonizes into build/cython/, which makes those .c
# files the extension modules' declared sources, and setuptools carries
# declared sources into an sdist whether or not MANIFEST.in mentions them --
# 90% of the uncompressed archive. The .pyx sources shipped above plus the
# cython build requirement regenerate them at install time.
prune build
